      "html": "\n<style data-kid=\"0\">\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n\n:root {\n  --color-primary: #0F172A;\n  --color-secondary: #1E293B;\n  --color-accent: #22C55E;\n  --color-background: #F8FAFC;\n  --color-border: #E2E8F0;\n}\n\nbody {\n  font-family: 'Inter', sans-serif;\n  background-color: var(--color-background);\n  color: var(--color-primary);\n  margin: 0;\n  padding: 0;\n}\n\n@keyframes marquee {\n  0% { transform: translateX(100%); }\n  100% { transform: translateX(-100%); }\n}\n\n.animate-marquee {\n  display: inline-block;\n  white-space: nowrap;\n  animation: marquee 20s linear infinite;\n}\n\n.vip-card-shadow {\n  box-shadow: 0 4px 6px -1px rgba(34, 197, 94, 0.1), 0 2px 4px -2px rgba(34, 197, 94, 0.1);\n}\n\n.btn-hover-effect {\n  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n}\n\n.btn-hover-effect:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 10px 15px -3px rgba(34, 197, 94, 0.2);\n}\n</style>\n\n<div class=\"max-w-[375px] mx-auto bg-[#F8FAFC] min-h-screen pb-24 relative overflow-hidden\" data-kid=\"1\">\n  \n  \n  <header class=\"p-4 pt-6\" data-kid=\"2\">\n    <div class=\"flex justify-between items-center mb-6\" data-kid=\"3\">\n      <div class=\"flex items-center gap-3\" data-kid=\"4\">\n        <div class=\"w-11 h-11 bg-linear-to-br from-[#22C55E] to-[#06B6D4] rounded-full flex items-center justify-center text-white text-xl font-bold shadow-md\" data-kid=\"5\">C</div>\n        <div class=\"flex flex-col -space-y-1\" data-kid=\"6\">\n          <span class=\"text-[17px] font-bold text-[#22C55E] tracking-tight\" data-kid=\"7\">Clutch</span>\n          <span class=\"text-[9px] text-slate-500 uppercase tracking-widest font-bold\" data-kid=\"8\">Incorporated</span>\n        </div>\n      </div>\n      <button class=\"w-10 h-10 bg-[#22C55E]/10 border border-[#22C55E]/30 rounded-full flex items-center justify-center text-xl text-[#0F172A] hover:bg-[#22C55E]/20 transition-colors\" data-kid=\"9\">👤</button>\n    </div>\n\n    \n    <div class=\"bg-linear-to-br from-[#0F172A] to-[#1E293B] rounded-2xl p-6 text-white shadow-xl shadow-slate-200/50 text-center relative overflow-hidden\" data-kid=\"10\">\n      <div class=\"absolute top-0 right-0 w-32 h-32 bg-white/5 rounded-full -mr-16 -mt-16 blur-2xl\" data-kid=\"11\"></div>\n      <h2 class=\"text-2xl font-bold mb-1 relative z-10\" data-kid=\"12\">Hi, <span class=\"text-white\" data-kid=\"13\">Collins</span></h2>\n      <p class=\"text-white/70 text-sm mb-5 relative z-10\" data-kid=\"14\">Welcome back</p>\n      \n      \n      <div class=\"w-full overflow-hidden bg-[#22C55E]/10 rounded-full py-2 border-l-4 border-[#22C55E] relative z-10\" data-kid=\"15\">\n        <div class=\"animate-marquee text-[#22C55E] text-[11px] font-semibold px-4 tracking-wide\" data-kid=\"16\">\n          Dear users, welcome to join us. The daily working hours are from 10:00 am to 23:00 pm EST\n        </div>\n      </div>\n    </div>\n  </header>\n\n  \n  <main class=\"px-4 space-y-4 mb-6\" data-kid=\"17\">\n    \n    <div class=\"grid grid-cols-4 gap-2\" data-kid=\"18\">\n      <button class=\"btn-hover-effect flex flex-col items-center gap-2 bg-white border border-slate-100 rounded-xl py-4 hover:border-[#22C55E] hover:bg-[#22C55E] hover:text-white group shadow-xs\" data-kid=\"19\">\n        <span class=\"text-2xl group-hover:scale-110 transition-transform\" data-kid=\"20\">🔧</span>\n        <span class=\"text-[9px] font-bold tracking-tighter\" data-kid=\"21\">SERVICE</span>\n      </button>\n      <button class=\"btn-hover-effect flex flex-col items-center gap-2 bg-white border border-slate-100 rounded-xl py-4 hover:border-[#22C55E] hover:bg-[#22C55E] hover:text-white group shadow-xs\" data-kid=\"22\">\n        <span class=\"text-2xl group-hover:scale-110 transition-transform\" data-kid=\"23\">💰</span>\n        <span class=\"text-[9px] font-bold tracking-tighter\" data-kid=\"24\">WITHDRAW</span>\n      </button>\n      <button class=\"btn-hover-effect flex flex-col items-center gap-2 bg-white border border-slate-100 rounded-xl py-4 hover:border-[#22C55E] hover:bg-[#22C55E] hover:text-white group shadow-xs\" data-kid=\"25\">\n        <span class=\"text-2xl group-hover:scale-110 transition-transform\" data-kid=\"26\">💳</span>\n        <span class=\"text-[9px] font-bold tracking-tighter\" data-kid=\"27\">DEPOSIT</span>\n      </button>\n      <button class=\"btn-hover-effect flex flex-col items-center gap-2 bg-white border border-slate-100 rounded-xl py-4 hover:border-[#22C55E] hover:bg-[#22C55E] hover:text-white group shadow-xs\" data-kid=\"28\">\n        <span class=\"text-2xl group-hover:scale-110 transition-transform\" data-kid=\"29\">📈</span>\n        <span class=\"text-[9px] font-bold tracking-tighter\" data-kid=\"30\">TRADING</span>\n      </button>\n    </div>\n\n    \n    <div class=\"grid grid-cols-4 gap-2\" data-kid=\"31\">\n      <button class=\"btn-hover-effect flex flex-col items-center gap-2 bg-white border border-slate-100 rounded-xl py-4 hover:border-[#22C55E] hover:bg-[#22C55E] hover:text-white group shadow-xs\" data-kid=\"32\">\n        <span class=\"text-2xl group-hover:scale-110 transition-transform\" data-kid=\"33\">📋</span>\n        <span class=\"text-[9px] font-bold tracking-tighter\" data-kid=\"34\">T&C</span>\n      </button>\n      <button class=\"btn-hover-effect flex flex-col items-center gap-2 bg-white border border-slate-100 rounded-xl py-4 hover:border-[#22C55E] hover:bg-[#22C55E] hover:text-white group shadow-xs\" data-kid=\"35\">\n        <span class=\"text-2xl group-hover:scale-110 transition-transform\" data-kid=\"36\">📜</span>\n        <span class=\"text-[9px] font-bold tracking-tighter\" data-kid=\"37\">CERTIFICATE</span>\n      </button>\n      <button class=\"btn-hover-effect flex flex-col items-center gap-2 bg-white border border-slate-100 rounded-xl py-4 hover:border-[#22C55E] hover:bg-[#22C55E] hover:text-white group shadow-xs\" data-kid=\"38\">\n        <span class=\"text-2xl group-hover:scale-110 transition-transform\" data-kid=\"39\">❓</span>\n        <span class=\"text-[9px] font-bold tracking-tighter\" data-kid=\"40\">FAQS</span>\n      </button>\n      <button class=\"btn-hover-effect flex flex-col items-center gap-2 bg-white border border-slate-100 rounded-xl py-4 hover:border-[#22C55E] hover:bg-[#22C55E] hover:text-white group shadow-xs\" data-kid=\"41\">\n        <span class=\"text-2xl group-hover:scale-110 transition-transform\" data-kid=\"42\">ℹ️</span>\n        <span class=\"text-[9px] font-bold tracking-tighter\" data-kid=\"43\">ABOUT</span>\n      </button>\n    </div>\n\n    \n    <section class=\"bg-white rounded-2xl p-5 border border-slate-100 shadow-sm mt-2\" data-kid=\"44\">\n      <div class=\"flex justify-between items-center mb-5\" data-kid=\"45\">\n        <h3 class=\"text-[#22C55E] text-[15px] font-extrabold tracking-tight\" data-kid=\"46\">CONTINUOUS SIGN IN</h3>\n        <span class=\"text-[10px] bg-[#22C55E] text-white px-3 py-1.5 rounded-full font-bold shadow-sm\" data-kid=\"47\">SIGN IN NOW (0/15)</span>\n      </div>\n      \n      <div class=\"grid grid-cols-3 gap-2.5 mb-5\" data-kid=\"48\">\n        <div class=\"bg-linear-to-br from-[#22C55E]/8 to-[#22C55E]/2 border border-[#22C55E]/20 rounded-xl p-3 text-center text-[#22C55E] text-[10px] font-bold\" data-kid=\"49\">USDT +300</div>\n        <div class=\"bg-linear-to-br from-[#22C55E]/8 to-[#22C55E]/2 border border-[#22C55E]/20 rounded-xl p-3 text-center text-[#22C55E] text-[10px] font-bold\" data-kid=\"50\">USDT +150</div>\n        <div class=\"bg-linear-to-br from-[#22C55E]/8 to-[#22C55E]/2 border border-[#22C55E]/20 rounded-xl p-3 text-center text-[#22C55E] text-[10px] font-bold\" data-kid=\"51\">USDT +500</div>\n        <div class=\"bg-linear-to-br from-[#22C55E]/8 to-[#22C55E]/2 border border-[#22C55E]/20 rounded-xl p-3 text-center text-[#22C55E] text-[10px] font-bold\" data-kid=\"52\">USDT +1000</div>\n        <div class=\"bg-linear-to-br from-[#22C55E]/8 to-[#22C55E]/2 border border-[#22C55E]/20 rounded-xl p-3 text-center text-[#22C55E] text-[10px] font-bold\" data-kid=\"53\">USDT +50</div>\n        <div class=\"bg-linear-to-br from-[#22C55E]/8 to-[#22C55E]/2 border border-[#22C55E]/20 rounded-xl p-3 text-center text-[#22C55E] text-[10px] font-bold\" data-kid=\"54\">USDT +300</div>\n      </div>\n      \n      <div class=\"pt-4 border-t border-slate-50 text-center text-slate-400 text-xs font-medium\" data-kid=\"55\">\n        Base salary: <span class=\"text-[#22C55E] font-bold ml-1\" data-kid=\"56\">0.0</span> <span class=\"text-slate-500\" data-kid=\"57\">USDT</span>\n      </div>\n    </section>\n\n    \n    <section class=\"bg-white rounded-2xl p-5 border border-slate-100 shadow-sm\" data-kid=\"58\">\n      <div class=\"flex justify-between items-center mb-5\" data-kid=\"59\">\n        <h3 class=\"text-[#0F172A] text-lg font-bold\" data-kid=\"60\">Vip Levels</h3>\n        <a href=\"#\" class=\"text-[#22C55E] text-[13px] font-bold hover:text-[#16a34a] transition-colors\" data-kid=\"61\">View more</a>\n      </div>\n      \n      <div class=\"grid grid-cols-2 gap-3\" data-kid=\"62\">\n        \n        <div class=\"bg-linear-to-br from-[#22C55E]/8 to-[#22C55E]/2 border border-[#22C55E]/15 rounded-xl p-4 text-center hover:border-[#22C55E]/40 transition-all vip-card-shadow\" data-kid=\"63\">\n          <h4 class=\"text-[#22C55E] font-extrabold text-lg mb-1\" data-kid=\"64\">VIP 1</h4>\n          <p class=\"text-slate-400 text-[9px] leading-tight font-medium\" data-kid=\"65\">0.5% commission.</p>\n          <p class=\"text-slate-400 text-[9px] leading-tight font-medium\" data-kid=\"66\">40 orders per round.</p>\n        </div>\n        \n        <div class=\"bg-linear-to-br from-[#22C55E]/8 to-[#22C55E]/2 border border-[#22C55E]/15 rounded-xl p-4 text-center hover:border-[#22C55E]/40 transition-all vip-card-shadow\" data-kid=\"67\">\n          <h4 class=\"text