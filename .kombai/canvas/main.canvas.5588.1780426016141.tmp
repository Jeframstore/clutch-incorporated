fy-between border border-transparent hover:border-[#FFDB00] cursor-pointer transition-all border-[#FFDB00]\" data-kid=\"130\">\n                    <div class=\"flex flex-col\" data-kid=\"131\">\n                        <span class=\"text-white font-bold text-base\" data-kid=\"132\">BTC/USDT</span>\n                        <span class=\"text-[#767980] text-xs\" data-kid=\"133\">Vol 45.2B</span>\n                    </div>\n                    <div class=\"text-right\" data-kid=\"134\">\n                        <span class=\"text-[#FFDB00] font-bold block\" data-kid=\"135\">64,235.50</span>\n                        <span class=\"text-[#00AD7F] text-[10px] font-bold bg-[#00AD7F]/10 px-1.5 py-0.5 rounded\" data-kid=\"136\">+2.45%</span>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        \n        <section class=\"bg-[#111212] border border-[#2E3033] rounded-2xl p-5\" data-kid=\"137\">\n            <h3 class=\"text-white text-base font-bold mb-4 flex items-center gap-2\" data-kid=\"138\">\n                <span class=\"w-1.5 h-4 bg-[#FFDB00] rounded-full\" data-kid=\"139\"></span>\n                My Assets\n            </h3>\n            <div class=\"space-y-2\" data-kid=\"140\">\n                <div class=\"bg-[#222326] p-4 rounded-xl flex justify-between items-center border border-[#2E3033]\" data-kid=\"141\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"142\">\n                        <div class=\"w-8 h-8 bg-green-500/10 rounded-full flex items-center justify-center text-[#00AD7F] text-xs font-bold\" data-kid=\"143\">U</div>\n                        <span class=\"text-[#A8ABB2] font-semibold text-sm uppercase\" data-kid=\"144\">USDT</span>\n                    </div>\n                    <span class=\"text-white font-bold tabular-nums text-lg\" data-kid=\"145\">1,250.45</span>\n                </div>\n                <div class=\"bg-[#222326] p-4 rounded-xl flex justify-between items-center border border-[#2E3033]\" data-kid=\"146\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"147\">\n                        <div class=\"w-8 h-8 bg-orange-500/10 rounded-full flex items-center justify-center text-orange-500 text-xs font-bold\" data-kid=\"148\">B</div>\n                        <span class=\"text-[#A8ABB2] font-semibold text-sm uppercase\" data-kid=\"149\">BTC</span>\n                    </div>\n                    <span class=\"text-white font-bold tabular-nums text-lg\" data-kid=\"150\">0.00421</span>\n                </div>\n            </div>\n        </section>\n\n    </main>\n\n    \n    <nav class=\"fixed bottom-0 left-0 right-0 bg-black/95 backdrop-blur-xl border-t border-[#2E3033] flex justify-around py-3 px-2 z-[60] max-w-[375px] mx-auto shadow-[0_-10px_20px_rgba(0,0,0,0.5)]\" data-kid=\"151\">\n        <button class=\"flex flex-col items-center gap-1.5 group transition-all\" data-kid=\"152\">\n            <div class=\"w-10 h-10 flex items-center justify-center rounded-xl bg-transparent group-hover:bg-[#222326] transition-colors\" data-kid=\"153\">\n                <span class=\"text-xl grayscale group-hover:grayscale-0\" data-kid=\"154\">🏠</span>\n            </div>\n            <span class=\"text-[10px] font-bold text-[#767980] group-hover:text-white uppercase tracking-tighter\" data-kid=\"155\">Home</span>\n        </button>\n        <button class=\"flex flex-col items-center gap-1.5 group transition-all\" data-kid=\"156\">\n            <div class=\"w-10 h-10 flex items-center justify-center rounded-xl bg-[#FFDB00]/10 border border-[#FFDB00]/20\" data-kid=\"157\">\n                <span class=\"text-xl\" data-kid=\"158\">🚀</span>\n            </div>\n            <span class=\"text-[10px] font-bold text-[#FFDB00] uppercase tracking-tighter\" data-kid=\"159\">Trade</span>\n        </button>\n        <button class=\"flex flex-col items-center gap-1.5 group transition-all\" data-kid=\"160\">\n            <div class=\"w-10 h-10 flex items-center justify-center rounded-xl bg-transparent group-hover:bg-[#222326] transition-colors\" data-kid=\"161\">\n                <span class=\"text-xl grayscale group-hover:grayscale-0\" data-kid=\"162\">📊</span>\n            </div>\n            <span class=\"text-[10px] font-bold text-[#767980] group-hover:text-white uppercase tracking-tighter\" data-kid=\"163\">Records</span>\n        </button>\n        <button class=\"flex flex-col items-center gap-1.5 group transition-all\" data-kid=\"164\">\n            <div class=\"w-10 h-10 flex items-center justify-center rounded-xl bg-transparent group-hover:bg-[#222326] transition-colors\" data-kid=\"165\">\n                <span class=\"text-xl grayscale group-hover:grayscale-0\" data-kid=\"166\">👤</span>\n            </div>\n            <span class=\"text-[10px] font-bold text-[#767980] group-hover:text-white uppercase tracking-tighter\" data-kid=\"167\">Account</span>\n        </button>\n    </nav>\n</div>\n",
