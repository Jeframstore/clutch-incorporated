      "html": "\n<div class=\"bg-[#000000] text-white font-sans min-h-[1400px] relative pb-[90px]\" data-kid=\"0\">\n    <style data-kid=\"1\">\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n        \n        :root {\n            --color-buy: #00AD7F;\n            --color-sell: #DB426B;\n            --color-accent: #FFDB00;\n            --bg-card: #111212;\n            --bg-input: #222326;\n            --border: #2E3033;\n            --text-muted: #767980;\n            --text-light: #A8ABB2;\n        }\n\n        body {\n            font-family: 'Inter', sans-serif;\n            background-color: #000000;\n        }\n\n        /* Custom range slider styling */\n        .trade-slider {\n            -webkit-appearance: none;\n            width: 100%;\n            height: 4px;\n            background: var(--border);\n            border-radius: 2px;\n            outline: none;\n        }\n\n        .trade-slider::-webkit-slider-thumb {\n            -webkit-appearance: none;\n            width: 14px;\n            height: 14px;\n            background: var(--color-accent);\n            border-radius: 50%;\n            cursor: pointer;\n            border: 2px solid #000;\n        }\n\n        /* Custom scrollbar */\n        .coins-list::-webkit-scrollbar {\n            width: 4px;\n        }\n        .coins-list::-webkit-scrollbar-track {\n            background: #111212;\n        }\n        .coins-list::-webkit-scrollbar-thumb {\n            background: #2E3033;\n            border-radius: 2px;\n        }\n    </style>\n\n    \n    <header class=\"bg-black/90 backdrop-blur-md px-4 py-4 sticky top-0 z-50 border-b border-[#2E3033]\" data-kid=\"2\">\n        <div class=\"flex items-center justify-between\" data-kid=\"3\">\n            <div class=\"flex items-center gap-3\" data-kid=\"4\">\n                <div class=\"w-10 h-10 bg-[#FFDB00] rounded-lg flex items-center justify-center\" data-kid=\"5\">\n                    <span class=\"text-black font-extrabold text-2xl\" data-kid=\"6\">C</span>\n                </div>\n                <div class=\"flex flex-col leading-none\" data-kid=\"7\">\n                    <span class=\"text-white font-bold text-lg tracking-tight\" data-kid=\"8\">Clutch</span>\n                    <span class=\"text-[#767980] text-[10px] font-medium tracking-widest uppercase\" data-kid=\"9\">Incorporated</span>\n                </div>\n            </div>\n            <button class=\"w-10 h-10 flex items-center justify-center rounded-full hover:bg-[#222326] transition-colors\" data-kid=\"10\">\n                <span class=\"text-2xl\" data-kid=\"11\">←</span>\n            </button>\n        </div>\n    </header>\n\n    <main class=\"px-4 pt-6 space-y-6\" data-kid=\"12\">\n        \n        \n        <section class=\"bg-[#111212] border border-[#2E3033] rounded-2xl p-5 flex justify-between items-center\" data-kid=\"13\">\n            <div data-kid=\"14\">\n                <h2 class=\"text-xl font-bold text-white mb-1\" data-kid=\"15\">BTC/USDT</h2>\n                <div class=\"flex items-center gap-2\" data-kid=\"16\">\n                    <span class=\"text-[#00AD7F] font-bold text-sm\" data-kid=\"17\">+2.45%</span>\n                    <span class=\"text-[#767980] text-xs\" data-kid=\"18\">24h Vol 45.2B</span>\n                </div>\n            </div>\n            <div class=\"text-right\" data-kid=\"19\">\n                <p class=\"text-[#FFDB00] text-2xl font-black tabular-nums leading-none\" data-kid=\"20\">64,235.50</p>\n                <p class=\"text-[#767980] text-sm mt-1\" data-kid=\"21\">≈ $64,235.50</p>\n            </div>\n        </section>\n\n        \n        <section class=\"space-y-4\" data-kid=\"22\">\n            \n            <div class=\"flex gap-2\" data-kid=\"23\">\n                <button class=\"flex-1 py-3.5 bg-[#00AD7F] text-white font-bold rounded-xl shadow-lg shadow-[#00AD7F]/20\" data-kid=\"24\">Buy</button>\n                <button class=\"flex-1 py-3.5 bg-[#222326] border border-[#2E3033] text-[#A8ABB2] font-bold rounded-xl\" data-kid=\"25\">Sell</button>\n            </div>\n\n            \n            <div class=\"flex border-b border-[#2E3033]\" data-kid=\"26\">\n                <button class=\"px-5 py-2.5 text-[#FFDB00] border-b-2 border-[#FFDB00] text-sm font-semibold\" data-kid=\"27\">Limit</button>\n                <button class=\"px-5 py-2.5 text-[#767980] text-sm font-semibold hover:text-white transition-colors\" data-kid=\"28\">Market</button>\n            </div>\n\n            \n            <div class=\"bg-[#111212] border border-[#2E3033] rounded-2xl p-5 space-y-5\" data-kid=\"29\">\n                <div class=\"flex justify-between text-xs items-center\" data-kid=\"30\">\n                    <span class=\"text-[#767980]\" data-kid=\"31\">Available Balance</span>\n                    <span class=\"text-white font-bold tracking-tight\" data-kid=\"32\">1,250.45 USDT</span>\n                </div>\n\n                \n                <div class=\"space-y-1.5\" data-kid=\"33\">\n                    <label class=\"text-xs text-[#767980] font-medium ml-1\" data-kid=\"34\">Limit Price</label>\n                    <div class=\"relative flex items-center group\" data-kid=\"35\">\n                        <input type=\"number\" value=\"64235.50\" step=\"0.01\" class=\"w-full bg-[#222326] border border-[#2E3033] rounded-xl p-4 text-white font-semibold focus:outline-none focus:border-[#FFDB00] focus:ring-1 focus:ring-[#FFDB00]/30 transition-all\" data-kid=\"36\">\n                        <div class=\"absolute right-3 flex flex-col gap-1\" data-kid=\"37\">\n                            <button class=\"w-6 h-5 flex items-center justify-center bg-[#2E3033] rounded text-[10px] text-white hover:bg-[#404247]\" data-kid=\"38\">▲</button>\n                            <button class=\"w-6 h-5 flex items-center justify-center bg-[#2E3033] rounded text-[10px] text-white hover:bg-[#404247]\" data-kid=\"39\">▼</button>\n                        </div>\n                    </div>\n                </div>\n\n                \n                <div class=\"space-y-1.5\" data-kid=\"40\">\n                    <label class=\"text-xs text-[#767980] font-medium ml-1\" data-kid=\"41\">Amount (BTC)</label>\n                    <input type=\"number\" placeholder=\"0.00\" class=\"w-full bg-[#222326] border border-[#2E3033] rounded-xl p-4 text-white font-semibold focus:outline-none focus:border-[#FFDB00] focus:ring-1 focus:ring-[#FFDB00]/30 transition-all\" data-kid=\"42\">\n                </div>\n\n                \n                <div class=\"space-y-3 px-1\" data-kid=\"43\">\n                    <input type=\"range\" min=\"0\" max=\"100\" value=\"0\" class=\"trade-slider\" data-kid=\"44\">\n                    <div class=\"flex justify-between text-[10px] text-[#767980] font-bold uppercase tracking-wider\" data-kid=\"45\">\n                        <span data-kid=\"46\">0%</span>\n                        <span data-kid=\"47\">25%</span>\n                        <span data-kid=\"48\">50%</span>\n                        <span data-kid=\"49\">75%</span>\n                        <span data-kid=\"50\">100%</span>\n                    </div>\n                </div>\n\n                \n                <div class=\"space-y-1.5\" data-kid=\"51\">\n                    <label class=\"text-xs text-[#767980] font-medium ml-1\" data-kid=\"52\">Total (USDT)</label>\n                    <div class=\"w-full bg-[#18191B] border border-[#2E3033] rounded-xl p-4 text-[#767980] font-semibold\" data-kid=\"53\">\n                        0.00\n                    </div>\n                </div>\n\n                \n                <button class=\"w-full py-4.5 bg-[#00AD7F] hover:bg-[#22BD8F] active:scale-[0.98] text-white font-extrabold text-lg rounded-xl shadow-lg shadow-[#00AD7F]/30 transition-all uppercase tracking-wide\" data-kid=\"54\">\n                    Buy BTC\n                </button>\n            </div>\n        </section>\n\n        \n        <section class=\"bg-[#111212] border border-[#2E3033] rounded-2xl p-5\" data-kid=\"55\">\n            <h3 class=\"text-white text-base font-bold mb-4 flex items-center gap-2\" data-kid=\"56\">\n                <span class=\"w-1.5 h-4 bg-[#FFDB00] rounded-full\" data-kid=\"57\"></span>\n                Order Book\n            </h3>\n            <div class=\"flex justify-between text-[11px] text-[#767980] font-bold uppercase mb-3 pb-2 border-b border-[#2E3033]\" data-kid=\"58\">\n                <span data-kid=\"59\">Price (USDT)</span>\n                <span data-kid=\"60\">Amount (BTC)</span>\n                <span class=\"text-right\" data-kid=\"61\">Total</span>\n            </div>\n            \n            \n            <div class=\"space-y-1 mb-3\" data-kid=\"62\">\n                <div class=\"flex justify-between text-[13px] font-medium\" data-kid=\"63\">\n                    <span class=\"text-[#DB426B]\" data-kid=\"64\">64238.1</span>\n                    <span class=\"text-[#A8ABB2]\" data-kid=\"65\">0.452</span>\n                    <span class=\"text-[#767980]\" data-kid=\"66\">29,035.6</span>\n                </div>\n                <div class=\"flex justify-between text-[13px] font-medium\" data-kid=\"67\">\n                    <span class=\"text-[#DB426B]\" data-kid=\"68\">64237.5</span>\n                    <span class=\"text-[#A8ABB2]\" data-kid=\"69\">1.205</span>\n                    <span class=\"text-[#767980]\" data-kid=\"70\">77,406.1</span>\n                </div>\n                <div class=\"flex justify-between text-[13px] font-medium\" data-kid=\"71\">\n                    <span class=\"text-[#DB426B]\" data-kid=\"72\">64236.9</span>\n                    <span class=\"text-[#A8ABB2]\" data-kid=\"73\">0.089</span>\n                    <span class=\"text-[#767980]\" data-kid=\"74\">5,717.0</span>\n                </div>\n            </div>\n\n            \n            <d