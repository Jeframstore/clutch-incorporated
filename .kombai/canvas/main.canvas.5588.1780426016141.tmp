      "html": "\n<style data-kid=\"0\">\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');\n\n    :root {\n        --color-gold: #ffd700;\n        --color-gold-dark: #ffb347;\n        --color-bg-start: #0a0a0a;\n        --color-bg-end: #1a1a2e;\n        --glass-bg: rgba(18, 18, 24, 0.95);\n        --glass-border: rgba(255, 255, 255, 0.1);\n        --glass-input-bg: rgba(255, 255, 255, 0.08);\n        --glass-input-border: rgba(255, 255, 255, 0.15);\n    }\n\n    body {\n        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n        margin: 0;\n        background: linear-gradient(135deg, var(--color-bg-start) 0%, var(--color-bg-end) 100%);\n    }\n\n    .login-container {\n        display: flex;\n        justify-content: center;\n        align-items: center;\n        min-height: 800px;\n        padding: 24px;\n    }\n\n    .login-card {\n        background: rgba(18, 18, 24, 0.9);\n        backdrop-filter: blur(16px);\n        -webkit-backdrop-filter: blur(16px);\n        border-radius: 32px;\n        padding: 48px 36px;\n        width: 100%;\n        max-width: 375px;\n        box-shadow: 0 30px 60px -12px rgba(0, 0, 0, 0.8), inset 0 1px 1px rgba(255, 255, 255, 0.1);\n        border: 1px solid rgba(255, 255, 255, 0.08);\n    }\n\n    .logo-section {\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        gap: 12px;\n        margin-bottom: 32px;\n    }\n\n    .big-c {\n        font-size: 48px;\n        font-weight: 900;\n        color: var(--color-gold);\n        line-height: 1;\n        text-shadow: 0 0 25px rgba(255, 215, 0, 0.4);\n        font-family: 'Plus Jakarta Sans', sans-serif;\n        background: linear-gradient(135deg, #ffd700, #ffb347);\n        -webkit-background-clip: text;\n        -webkit-text-fill-color: transparent;\n    }\n\n    .logo-text {\n        display: flex;\n        flex-direction: column;\n    }\n\n    .clutch {\n        font-size: 22px;\n        font-weight: 700;\n        color: white;\n        letter-spacing: -0.5px;\n        line-height: 1.1;\n    }\n\n    .incorporated {\n        font-size: 10px;\n        font-weight: 600;\n        color: var(--color-gold);\n        text-transform: uppercase;\n        letter-spacing: 2px;\n        opacity: 0.8;\n    }\n\n    .login-title {\n        font-size: 28px;\n        font-weight: 600;\n        color: white;\n        text-align: center;\n        margin-bottom: 32px;\n    }\n\n    .input-group {\n        margin-bottom: 20px;\n    }\n\n    .input-group label {\n        display: block;\n        color: #888;\n        font-size: 14px;\n        font-weight: 500;\n        margin-bottom: 10px;\n        margin-left: 4px;\n    }\n\n    .input-group input {\n        width: 100%;\n        padding: 16px 20px;\n        background: rgba(255, 255, 255, 0.05);\n        border: 1px solid rgba(255, 255, 255, 0.12);\n        border-radius: 16px;\n        color: white;\n        font-size: 16px;\n        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);\n        box-sizing: border-box;\n    }\n\n    .input-group input:hover {\n        background: rgba(255, 255, 255, 0.08);\n        border-color: rgba(255, 255, 255, 0.2);\n    }\n\n    .input-group input:focus {\n        outline: none;\n        border-color: var(--color-gold);\n        background: rgba(255, 255, 255, 0.12);\n        box-shadow: 0 0 0 4px rgba(255, 215, 0, 0.1);\n    }\n\n    .input-group input::placeholder {\n        color: #444;\n    }\n\n    .signin-btn {\n        width: 100%;\n        padding: 16px;\n        background: linear-gradient(135deg, var(--color-gold), var(--color-gold-dark));\n        border: none;\n        border-radius: 14px;\n        color: #1a1a2e;\n        font-size: 18px;\n        font-weight: 700;\n        cursor: pointer;\n        transition: all 0.2s ease;\n        margin-top: 10px;\n        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);\n    }\n\n    .signin-btn:hover {\n        transform: translateY(-2px);\n        box-shadow: 0 12px 24px rgba(255, 215, 0, 0.2);\n        filter: brightness(1.05);\n    }\n\n    .signin-btn:active {\n        transform: translateY(0);\n    }\n\n    .signup-link {\n        text-align: center;\n        margin: 24px 0;\n        color: #888;\n        font-size: 14px;\n    }\n\n    .signup-link a {\n        color: var(--color-gold);\n        text-decoration: none;\n        font-weight: 600;\n        transition: color 0.2s;\n    }\n\n    .signup-link a:hover {\n        text-decoration: underline;\n    }\n\n    .footer-text {\n        text-align: center;\n        color: #444;\n        font-size: 11px;\n        margin-top: 32px;\n        line-height: 1.6;\n        letter-spacing: 0.5px;\n        border-top: 1px solid rgba(255, 255, 255, 0.05);\n        padding-top: 24px;\n    }\n\n    /* Additional polish for modern feel */\n    .forgot-pass {\n        display: block;\n        text-align: right;\n        margin-top: -10px;\n        margin-bottom: 20px;\n    }\n\n    .forgot-pass a {\n        color: var(--color-gold);\n        font-size: 13px;\n        text-decoration: none;\n        font-weight: 500;\n        opacity: 0.9;\n        transition: opacity 0.2s;\n    }\n\n    .forgot-pass a:hover {\n        opacity: 1;\n        text-decoration: underline;\n    }\n</style>\n\n<div class=\"login-container\" data-kid=\"1\">\n    <div class=\"login-card\" data-kid=\"2\">\n        <div class=\"logo-section\" data-kid=\"3\">\n            <div class=\"big-c\" data-kid=\"4\">C</div>\n            <div class=\"logo-text\" data-kid=\"5\">\n                <span class=\"clutch\" data-kid=\"6\">Clutch</span>\n                <span class=\"incorporated\" data-kid=\"7\">Incorporated</span>\n            </div>\n        </div>\n        \n        <h2 class=\"login-title\" data-kid=\"8\">Login</h2>\n        \n        <form id=\"loginForm\" data-kid=\"9\">\n            <div class=\"input-group\" data-kid=\"10\">\n                <label for=\"loginIdentifier\" data-kid=\"11\">Username or Email</label>\n                <input type=\"text\" id=\"loginIdentifier\" placeholder=\"Enter username or email\" required autocomplete=\"username\" data-kid=\"12\">\n            </div>\n            \n            <div class=\"input-group\" data-kid=\"13\">\n                <label for=\"loginPassword\" data-kid=\"14\">Password</label>\n                <input type=\"password\" id=\"loginPassword\" placeholder=\"Enter your password\" required autocomplete=\"current-password\" data-kid=\"15\">\n            </div>\n            \n            <div class=\"forgot-pass\" data-kid=\"16\">\n                <a href=\"#\" data-kid=\"17\">Forgot Password?</a>\n            </div>\n            \n            <button type=\"submit\" class=\"signin-btn\" data-kid=\"18\">Sign in</button>\n        </form>\n        \n        <div class=\"signup-link\" data-kid=\"19\">\n            New to Clutch? <a href=\"#\" data-kid=\"20\">Sign up now.</a>\n        </div>\n        \n        <div class=\"footer-text\" data-kid=\"21\">\n            © 2024 Clutch Incorporated.<br data-kid=\"22\">All rights reserved.\n        </div>\n    </div>\n</div>\n",
