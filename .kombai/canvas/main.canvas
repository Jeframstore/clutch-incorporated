      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --color-pitch-black: #0A0A0A;\n    --color-carbon-black: #1B1B1B;\n    --color-lime-flash: #80FF00;\n    --color-bright-gold: #FFD800;\n  }\n\n  .nav-blur {\n    background: rgba(27, 27, 27, 0.7);\n    backdrop-filter: blur(16px);\n    -webkit-backdrop-filter: blur(16px);\n  }\n\n  .active-glow {\n    filter: drop-shadow(0 0 6px rgba(255, 216, 0, 0.4));\n  }\n\n  .active-dot-glow {\n    box-shadow: 0 0 12px 2px rgba(255, 216, 0, 0.5);\n  }\n\n  .glass-border {\n    border: 1px solid rgba(255, 255, 255, 0.15);\n    border-top-color: rgba(255, 255, 255, 0.25);\n  }\n</style>\n\n<div class=\"w-[375px] bg-[var(--color-pitch-black)] flex flex-col justify-end p-4 pt-12 pb-12\" data-kid=\"1\">\n  \n  <div class=\"w-full relative\" data-kid=\"2\">\n    \n    <nav class=\"nav-blur w-full h-[78px] rounded-[30px] glass-border flex items-center justify-between px-8 shadow-[0_30px_70px_-10px_rgba(0,0,0,0.8)] relative\" data-kid=\"3\">\n      \n      \n      <button class=\"relative flex flex-col items-center justify-center gap-0.5 min-w-[64px] transition-all duration-300 active:scale-90 group cursor-pointer\" data-kid=\"4\">\n        <div class=\"relative flex flex-col items-center -top-0.5\" data-kid=\"5\">\n          <i class=\"ti ti-home text-[28px] text-[var(--color-bright-gold)] active-glow\" data-kid=\"6\"></i>\n          <span class=\"text-[10px] font-bold text-[var(--color-bright-gold)] tracking-widest uppercase font-['Plus_Jakarta_Sans'] mt-0.5\" data-kid=\"7\">Home</span>\n          \n          <div class=\"absolute -bottom-3 w-1.5 h-1.5 bg-[var(--color-bright-gold)] rounded-full active-dot-glow\" data-kid=\"8\"></div>\n        </div>\n        \n        <div class=\"absolute inset-x-0 -inset-y-2 bg-[var(--color-bright-gold)]/10 blur-xl rounded-full -z-10\" data-kid=\"9\"></div>\n      </button>\n\n      \n      <button class=\"flex flex-col items-center justify-center gap-0.5 min-w-[64px] transition-all duration-300 active:scale-90 group cursor-pointer pt-1\" data-kid=\"10\">\n        <i class=\"ti ti-square-check text-[28px] text-white/50 group-hover:text-white/80 transition-colors\" data-kid=\"11\"></i>\n        <span class=\"text-[10px] font-bold text-white/40 tracking-widest uppercase font-['Plus_Jakarta_Sans'] group-hover:text-white/70 mt-0.5\" data-kid=\"12\">Task</span>\n      </button>\n\n      \n      <button class=\"flex flex-col items-center justify-center gap-0.5 min-w-[64px] transition-all duration-300 active:scale-90 group cursor-pointer pt-1\" data-kid=\"13\">\n        <i class=\"ti ti-list text-[28px] text-white/50 group-hover:text-white/80 transition-colors\" data-kid=\"14\"></i>\n        <span class=\"text-[10px] font-bold text-white/40 tracking-widest uppercase font-['Plus_Jakarta_Sans'] group-hover:text-white/70 mt-0.5\" data-kid=\"15\">Records</span>\n      </button>\n\n      \n      <div class=\"absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[var(--color-lime-flash)]/10 via-white/20 via-[var(--color-bright-gold)]/10 to-transparent\" data-kid=\"16\"></div>\n    </nav>\n  </div>\n</div>\n",
