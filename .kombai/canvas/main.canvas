      "html": "\n<header class=\"w-[375px] h-[76px] bg-white/80 backdrop-blur-md border-b border-gray-200/40 flex items-center justify-between px-5 py-3 select-none\" data-kid=\"0\">\n  <style data-kid=\"1\">\n    @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@800;900&family=Inter:wght@400;500;600;700;800&display=swap');\n    \n    .font-montserrat {\n      font-family: 'Montserrat', sans-serif;\n    }\n    \n    .font-inter {\n      font-family: 'Inter', sans-serif;\n    }\n\n    /* Subtle animation for the logo cog on hover */\n    .logo-container:hover .cog-inner {\n      transform: rotate(45deg);\n    }\n    \n    .cog-inner {\n      transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);\n      transform-origin: center;\n    }\n  </style>\n\n  \n  <div class=\"flex items-center gap-3 logo-container cursor-pointer\" data-kid=\"2\">\n    \n    <div class=\"relative w-[46px] h-[46px] flex items-center justify-center shrink-0\" data-kid=\"3\">\n      <svg viewBox=\"0 0 100 100\" class=\"w-full h-full text-[#FFBF00] fill-current drop-shadow-xs\" data-kid=\"4\">\n        \n        <g class=\"cog-inner\" data-kid=\"5\">\n          \n          <path d=\"M50 10 L54 10 L56 18 L44 18 L46 10 Z\" transform=\"rotate(0 50 50)\" data-kid=\"6\"></path>\n          <path d=\"M50 10 L54 10 L56 18 L44 18 L46 10 Z\" transform=\"rotate(45 50 50)\" data-kid=\"7\"></path>\n          <path d=\"M50 10 L54 10 L56 18 L44 18 L46 10 Z\" transform=\"rotate(90 50 50)\" data-kid=\"8\"></path>\n          <path d=\"M50 10 L54 10 L56 18 L44 18 L46 10 Z\" transform=\"rotate(135 50 50)\" data-kid=\"9\"></path>\n          <path d=\"M50 10 L54 10 L56 18 L44 18 L46 10 Z\" transform=\"rotate(180 50 50)\" data-kid=\"10\"></path>\n          <path d=\"M50 10 L54 10 L56 18 L44 18 L46 10 Z\" transform=\"rotate(225 50 50)\" data-kid=\"11\"></path>\n          <path d=\"M50 10 L54 10 L56 18 L44 18 L46 10 Z\" transform=\"rotate(270 50 50)\" data-kid=\"12\"></path>\n          <path d=