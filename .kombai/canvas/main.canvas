      "html": "\n<style data-kid=\"0\">\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    :root {\n        --color-bg-page: #0A0A0A;\n        --color-bg-surface: #1B1B1B;\n        --color-primary: #FFD800;\n        --color-secondary: #80FF00;\n        --color-text-primary: #FFFFFF;\n        --color-text-muted: #A1A1AA;\n    }\n\n    body {\n        background-color: var(--color-bg-page);\n        color: var(--color-text-primary);\n        font-family: 'IBM Plex Sans', sans-serif;\n        margin: 0;\n        padding: 0;\n    }\n\n    .font-heading {\n        font-family: 'Plus Jakarta Sans', sans-serif;\n    }\n\n    .glass {\n        background: rgba(27, 27, 27, 0.7);\n        backdrop-filter: blur(12px);\n        -webkit-backdrop-filter: blur(12px);\n        border: 1px solid rgba(255, 255, 255, 0.05);\n    }\n\n    .glow-gold {\n        box-shadow: 0 0 20px rgba(255, 216, 0, 0.4);\n    }\n\n    .glow-green {\n        box-shadow: 0 0 20px rgba(128, 255, 0, 0.4);\n    }\n\n    .scanline {\n        background: linear-gradient(to bottom, transparent 50%, rgba(255, 255, 255, 0.02) 50%);\n        background-size: 100% 4px;\n        pointer-events: none;\n    }\n\n    .grid-bg {\n        background-image: radial-gradient(circle at 1px 1px, rgba(255, 255, 255, 0.05) 1px, transparent 0);\n        background-size: 24px 24px;\n    }\n\n    /* Hide scrollbar but allow scrolling */\n    .no-scrollbar::-webkit-scrollbar {\n        display: none;\n    }\n    .no-scrollbar {\n        -ms-overflow-style: none;\n        scrollbar-width: none;\n    }\n</style>\n\n<div class=\"relative w-[375px] mx-auto min-h-[900px] bg-[#0A0A0A] overflow-hidden flex flex-col font-['IBM_Plex_Sans']\" data-kid=\"1\">\n    \n    <header class=\"relative z-50 h-16 bg-black/40 backdrop-blur-xl border-b border-white/10 flex items-center justify-between px-5\" data-kid=\"2\">\n        <div class=\"flex items-center gap-3\" data-kid=\"3\">\n            <div class=\"w-9 h-9 rounded-full bg-[#FFD800] flex items-center justify-center shadow-[0_0_15px_rgba(255,216,0,0.5)]\" data-kid=\"4\">\n                <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/cog.svg\" class=\"w-6 h-6\" alt=\"Logo\" decoding=\"async\" loading=\"lazy\" data-kid=\"5\">\n            </div>\n            <div class=\"flex flex-col\" data-kid=\"6\">\n                <span class=\"text-white font-bold text-sm tracking-tight uppercase font-heading leading-none mb-0.5\" data-kid=\"7\">The Clutch Co</span>\n                <span class=\"text-[8px] text-[#80FF00] font-bold tracking-[0.2em] opacity-80 uppercase\" data-kid=\"8\">Real-time Sync</span>\n            </div>\n        </div>\n        <div class=\"relative\" data-kid=\"9\">\n            <div class=\"w-9 h-9 rounded-full border-2 border-[#80FF00] p-0.5 shadow-[0_0_8px_rgba(128,255,0,0.3)]\" data-kid=\"10\">\n                <img src=\"https://i.pravatar.cc/100?u=clutch\" class=\"w-full h-full rounded-full grayscale hover:grayscale-0 transition-all duration-300\" alt=\"Profile\" decoding=\"async\" loading=\"lazy\" data-kid=\"11\">\n            </div>\n            <div class=\"absolute -bottom-0.5 -right-0.5 w-3 h-3 bg-[#80FF00] rounded-full border-2 border-[#0A0A0A]\" data-kid=\"12\"></div>\n        </div>\n    </header>\n\n    \n    <main class=\"flex-1 px-5 pt-6 pb-24 no-scrollbar relative\" data-kid=\"13\">\n        <div class=\"absolute inset-0 grid-bg pointer-events-none opacity-40\" data-kid=\"14\"></div>\n        \n        \n        <section class=\"mb-8 relative\" data-kid=\"15\">\n            <div class=\"flex items-end justify-between mb-2\" data-kid=\"16\">\n                <div data-kid=\"17\">\n                    <div class=\"flex items-center gap-2 mb-1\" data-kid=\"18\">\n                        <div class=