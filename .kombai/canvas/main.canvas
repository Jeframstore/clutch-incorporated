      "html": "\n<div class=\"min-h-[900px] w-[375px] bg-[#0A0A0A] text-white font-['IBM_Plex_Sans'] relative flex flex-col mx-auto overflow-hidden shadow-2xl\" data-kid=\"0\">\n  <style data-kid=\"1\">\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n    \n    .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n    .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n    \n    .glass-surface {\n      background: rgba(27, 27, 27, 0.6);\n      backdrop-filter: blur(12px);\n      border: 1px solid rgba(255, 255, 255, 0.05);\n    }\n\n    .glass-border-gold {\n      border: 1px solid rgba(255, 216, 0, 0.2);\n    }\n\n    .glow-gold {\n      box-shadow: 0 0 20px rgba(255, 216, 0, 0.15);\n    }\n\n    .glow-gold-strong {\n      box-shadow: 0 0 30px rgba(255, 216, 0, 0.25);\n    }\n\n    .glow-lime {\n      box-shadow: 0 0 15px rgba(128, 255, 0, 0.15);\n    }\n\n    .cog-rotate {\n      animation: spin 8s linear infinite;\n    }\n\n    @keyframes spin {\n      from { transform: rotate(0deg); }\n      to { transform: rotate(360deg); }\n    }\n\n    /* Custom scrollbar for horizontal asset picker if needed */\n    .no-scrollbar::-webkit-scrollbar {\n      display: none;\n    }\n    .no-scrollbar {\n      -ms-overflow-style: none;\n      scrollbar-width: none;\n    }\n  </style>\n\n  \n  <header class=\"absolute top-0 z-50 w-full bg-[#0A0A0A]/70 backdrop-blur-md border-b border-white/10 px-4 h-16 flex items-center justify-between\" data-kid=\"2\">\n    <div class=\"flex items-center gap-3\" data-kid=\"3\">\n      <div class=\"relative w-9 h-9 flex items-center justify-center\" data-kid=\"4\">\n        \n        <div class=\"absolute inset-0 bg-[#FFD800] rounded-full cog-rotate\" style=\"clip-path: polygon(50% 0%, 61% 10%, 75% 10%, 80% 23%, 94% 28%, 90% 41%, 98% 54%, 88% 66%, 92% 79%, 79% 82%, 72% 95%, 59% 90%, 46% 98%, 34% 90%, 21% 94%, 18% 81%, 5% 76%, 10% 63%, 2% 50%, 12% 38%, 8% 25%, 21% 21%, 27% 8%, 41% 12%);\" data-kid=\"5\"></div>\n        <span class=\"relative z-10 font-heading font-800 text-black text-lg\" data-kid=\"6\">C</span>\n      </div>\n      <div class=\"flex flex-col -space-y-1\" data-kid=\"7\">\n        <span class=\"font-heading font-800 text-[13px] tracking-widest text-white\" data-kid=\"8\">THE CLUTCH CO</span>\n        <span class=\"text-[8px] font-bold text-[#FFD800] tracking-[0.2em] uppercase\" data-kid=\"9\">Premium Trading</span>\n      </div>\n    </div>\n    <div class=\"relative\" data-kid=\"10\">\n      <div class=\"w-9 h-9 rounded-full bg-[#1B1B1B] p-[1px] border border-white/10\" data-kid=\"11\">\n        <img src=\"https://i.pravatar.cc/100?u=clutch_user_1\" alt=\"avatar\" class=\"w-full h-full rounded-full object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"12\">\n      </div>\n      <div class=\"absolute -bottom-0.5 -right-0.5 w-3 h-3 bg-[#80FF00] rounded-full border-2 border-[#0A0A0A]\" data-kid=\"13\"></div>\n    </div>\n  </header>\n\n  \n  <main class=\"flex-1 px-5 pt-24 pb-32\" data-kid=\"14\">\n    \n    <div class=\"mb-8 pt-4\" data-kid=\"15\">\n      <div class=\"inline-flex items-center gap-2 px-3 py-1 bg-[#FFD800]/10 border border-[#FFD800]/20 rounded-full mb-3\" data-kid=\"16\">\n        <div class=\"w-1.5 h-1.5 rounded-full bg-[#FFD800] animate-pulse\" data-kid=\"17\"></div>\n        <span class=\"text-[10px] font-bold text-[#FFD800] uppercase tracking-wider\" data-kid=\"18\">Fast Network</span>\n      </div>\n      <h1 class=\"font-heading text-4xl font-700 text-white tracking-tight leading-none\" data-kid=\"19\">DEPOSIT</h1>\n      <p class=\"text-[#A1A1AA] text-sm mt-2 font-body\" data-kid=\"20\">Fund your account with crypto assets</p>\n    </div>\n\n    \n    <div class=\"space-y-4 mb-10\" data-kid=\"21\">\n      <div class=\"flex justify-between items-end\" data-kid=\"22\">\n        <label class=\"text-[10px] font-bold uppercase tracking-[0.2em] text-white/50\" data-kid=\"23\">Select Currency</label>\n        <span class=\"text-[10px] font-bold text-[#FFD800] border-b border-[#FFD800]/30 cursor-pointer\" data-kid=\"24\">View Rates</span>\n      </div>\n      <div class=\"grid grid-cols-3 gap-3\" data-kid=\"25\">\n        \n        <button class=\"relative group\" data-kid=\"26\">\n          <div class=\"absolute -inset-[1px] bg-gradient-to-b from-[#FFD800] to-transparent rounded-xl opacity-100 glow-gold\" data-kid=\"27\"></div>\n          <div class=\"relative glass-surface rounded-xl p-4 flex flex-col items-center gap-2 border-[#FFD800]/40\" data-kid=\"28\">\n            <div class=\"w-10 h-10 rounded-full bg-[#26A17B]/15 flex items-center justify-center border border-[#26A17B]/20\" data-kid=\"29\">\n              <span class=\"text-[#26A17B] font-bold text-lg\" data-kid=\"30\">₮</span>\n            </div>\n            <span class=\"text-xs font-bold font-body\" data-kid=\"31\">USDT</span>\n          </div>\n        </button>\n\n        \n        <button class=\"relative group opacity-50 hover:opacity-80 transition-opacity\" data-kid=\"32\">\n          <div class=\"absolute -inset-[1px] bg-white/5 rounded-xl opacity-0 group-hover:opacity-100\" data-kid=\"33\"></div>\n          <div class=\"relative glass-surface rounded-xl p-4 flex flex-col items-center gap-2\" data-kid=\"34\">\n            <div class=\"w-10 h-10 rounded-full bg-[#F7931A]/10 flex items-center justify-center border border-[#F7931A]/20\" data-kid=\"35\">\n              <span class=\"text-[#F7931A] font-bold text-lg\" data-kid=\"36\">₿</span>\n            </div>\n            <span class=\"text-xs font-bold font-body text-white/70\" data-kid=\"37\">BTC</span>\n          </div>\n        </button>\n\n        \n        <button class=\"relative group opacity-50 hover:opacity-80 transition-opacity\" data-kid=\"38\">\n          <div class=\"absolute -inset-[1px] bg-white/5 rounded-xl opacity-0 group-hover:opacity-100\" data-kid=\"39\"></div>\n          <div class=\"relative glass-surface rounded-xl p-4 flex flex-col items-center gap-2\" data-kid=\"40\">\n            <div class=\"w-10 h-10 rounded-full bg-[#627EEA]/10 flex items-center justify-center border border-[#627EEA]/20\" data-kid=\"41\">\n              <span class=\"text-[#627EEA] font-bold text-lg\" data-kid=\"42\">Ξ</span>\n            </div>\n            <span class=\"text-xs font-bold font-body text-white/70\" data-kid=\"43\">ETH</span>\n          </div>\n        </button>\n      </div>\n    </div>\n\n    \n    <div class=\"space-y-4 mb-10\" data-kid=\"44\">\n      <label class=\"text-[10px] font-bold uppercase tracking-[0.2em] text-white/50\" data-kid=\"45\">Blockchain Network</label>\n      <div class=\"flex flex-wrap gap-2\" data-kid=\"46\">\n        <button class=\"px-5 py-2.5 rounded-full text-xs font-bold bg-[#FFD800] text-black glow-gold shadow-lg shadow-[#FFD800]/10 transition-all active:scale-95 border-2 border-[#FFD800]\" data-kid=\"47\">TRC20</button>\n        <button class=\"px-5 py-2.5 rounded-full text-xs font-bold bg-[#1B1B1B] text-white border border-white/10 hover:border-white/30 transition-all active:scale-95\" data-kid=\"48\">ERC20</button>\n        <button class=\"px-5 py-2.5 rounded-full text-xs font-bold bg-[#1B1B1B] text-white border border-white/10 hover:border-white/30 transition-all active:scale-95\" data-kid=\"49\">BEP20</button>\n      </div>\n    </div>\n\n    \n    <div class=\"relative group\" data-kid=\"50\">\n      \n      <div class=\"absolute -inset-0.5 bg-[#FFD800]/5 rounded-3xl blur-2xl group-hover:bg-[#FFD800]/10 transition-all\" data-kid=\"51\"></div>\n      \n      <div class=\"relative glass-surface rounded-3xl p-8 flex flex-col items-center border-white/10 glow-gold-strong\" data-kid=\"52\">\n        \n        <div class=\"relative mb-8\" data-kid=\"53\">\n          <div class=\"absolute -inset-4 bg-[#FFD800]/5 rounded-full blur-xl animate-pulse\" data-kid=\"54\"></div>\n          <div class=\"bg-white p-4 rounded-2xl relative shadow-2xl\" data-kid=\"55\">\n            <img src=\"https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=TClutchCoAddressExample123456789&margin=0&bgcolor=ffffff&color=0a0a0a\" alt=\"Deposit QR\" class=\"w-36 h-36\" decoding=\"async\" loading=\"lazy\" data-kid=\"56\">\n          </div>\n        </div>\n\n        \n        <div class=\"w-full space-y-3\" data-kid=\"57\">\n          <div class=\"flex justify-between items-center px-1\" data-kid=\"58\">\n            <label class=\"text-[9px] font-bold uppercase tracking-[0.2em] text-white/60\" data-kid=\"59\">USDT (TRC20) Wallet Address</label>\n            <span class=\"text-[9px] font-bold text-[#80FF00] uppercase tracking-widest flex items-center gap-1\" data-kid=\"60\">\n              <span class=\"w-1 h-1 rounded-full bg-[#80FF00]\" data-kid=\"61\"></span>\n              Verified\n            </span>\n          </div>\n          \n          <div class=\"flex items-center gap-3 bg-black/40 border border-white/5 rounded-2xl p-4 group/addr\" data-kid=\"62\">\n            <code class=\"text-xs text-white/90 truncate flex-1 font-body tracking-wider\" data-kid=\"63\">TClutchCoAddressExample123456789...</code>\n            <button class=\"text-[#FFD800] p-2 hover:bg-[#FFD800]/10 rounded-xl transition-all active:scale-90\" data-kid=\"64\">\n              <svg class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"65\"><rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\" ry=\"2\" data-kid=\"66\"></rect><path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\" data-kid=\"67\"></path></svg>\n            </button>\n          </div>\n          \n          <p class=\"text-[10px] text-center text-white/40 pt-2 font-medium tracking-tight\" data-kid=\"68\">Minimum deposit amount: <span class=\"text-white\" data-kid=\"69\">10.00 USDT</span></p>\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"mt-8 space-y-4\" data-kid=\"70\">\n      <div class=\"bg-[#80FF00]/5 border border-[#80FF00]/10 rounded-2xl p-5 flex gap-4 glow-lime\" data-kid=\"71\">\n        <div class=\"w-10 h-10 rounded-xl bg-[#80FF00]/10 flex items-center justify-center shrink-0\" data-kid=\"72\">\n          <svg class=\"w-5 h-5 text-[#80FF00]\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"73\"><circle cx=\"12\" cy=\"12\" r=\"10\" data-kid=\"74\"></circle><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\" data-kid=\"75\"></line><line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\" data-kid=\"76\"></line></svg>\n        </div>\n        <div class=\"space-y-1\" data-kid=\"77\">\n          <h4 class=\"text-xs font-bold text-[#80FF00] uppercase tracking-wider\" data-kid=\"78\">Asset Safety Warning</h4>\n          <p class=\"text-[11px] text-white/70 leading-relaxed font-body\" data-kid=\"79\">Please double-check the network selection. USDT deposits on <span class=\"text-[#FFD800] font-bold underline decoration-[#FFD800]/30 underline-offset-4\" data-kid=\"80\">TRC20</span> are non-reversible if sent to other chains.</p>\n        </div>\n      </div>\n    </div>\n  </main>\n\n  \n  <nav class=\"absolute bottom-0 left-0 w-full bg-[#0A0A0A]/90 backdrop-blur-xl border-t border-white/5 px-8 h-20 flex items-center justify-between z-50\" data-kid=\"81\">\n    \n    <button class=\"flex flex-col items-center gap-1.5 text-[#A1A1AA] transition-colors group\" data-kid=\"82\">\n      <div class=\"p-1 rounded-lg group-active:scale-90 transition-transform\" data-kid=\"83\">\n        <svg class=\"w-6 h-6\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"84\"><path d=\"m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\" data-kid=\"85\"></path><polyline points=\"9 22 9 12 15 12 15 22\" data-kid=\"86\"></polyline></svg>\n      </div>\n      <span class=\"text-[9px] font-bold uppercase tracking-widest\" data-kid=\"87\">Home</span>\n    </button>\n    \n    \n    <button class=\"flex flex-col items-center gap-1.5 text-[#FFD800] relative group\" data-kid=\"88\">\n      <div class=\"absolute -top-3 w-12 h-1 bg-[#FFD800] rounded-full blur-sm opacity-50\" data-kid=\"89\"></div>\n      <div class=\"p-1 rounded-lg drop-shadow-[0_0_12px_rgba(255,216,0,0.4)]\" data-kid=\"90\">\n        <svg class=\"w-6 h-6\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"91\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\" data-kid=\"92\"></rect><line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\" data-kid=\"93\"></line><line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\" data-kid=\"94\"></line><line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\" data-kid=\"95\"></line><path d=\"m9 16 2 2 4-4\" data-kid=\"96\"></path></svg>\n      </div>\n      <span class=\"text-[9px] font-bold uppercase tracking-widest text-[#FFD800]\" data-kid=\"97\">Task</span>\n    </button>\n    \n    \n    <button class=\"flex flex-col items-center gap-1.5 text-[#A1A1AA] transition-colors group\" data-kid=\"98\">\n      <div class=\"p-1 rounded-lg group-active:scale-90 transition-transform\" data-kid=\"99\">\n        <svg class=\"w-6 h-6\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"100\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\" data-kid=\"101\"></path><polyline points=\"14 2 14 8 20 8\" data-kid=\"102\"></polyline><line x1=\"16\" y1=\"13\" x2=\"8\" y2=\"13\" data-kid=\"103\"></line><line x1=\"16\" y1=\"17\" x2=\"8\" y2=\"17\" data-kid=\"104\"></line><polyline points=\"10 9 9 9 8 9\" data-kid=\"105\"></polyline></svg>\n      </div>\n      <span class=\"text-[9px] font-bold uppercase tracking-widest\" data-kid=\"106\">Records</span>\n    </button>\n  </nav>\n\n  \n  <div class=\"absolute top-0 left-1/2 -translate-x-1/2 w-full h-[300px] bg-[#FFD800]/5 blur-[120px] pointer-events-none -z-10\" data-kid=\"107\"></div>\n</div>\n",
