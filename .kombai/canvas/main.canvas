      "html": "\n<div class=\"flex items-start justify-center bg-[#050505] font-['IBM_Plex_Sans'] text-white py-12\" data-kid=\"0\">\n  \n  <div class=\"relative w-[375px] h-[812px] bg-[#0A0A0A] shadow-2xl overflow-hidden rounded-[40px] border border-white/10\" data-kid=\"1\">\n    \n    \n    <header class=\"absolute top-0 left-0 right-0 z-50 flex h-16 items-center justify-between border-b border-white/10 bg-[#0A0A0A]/80 px-4 backdrop-blur-md\" data-kid=\"2\">\n      <div class=\"flex items-center gap-2\" data-kid=\"3\">\n        <div class=\"flex h-8 w-8 items-center justify-center rounded-full bg-[#FFD800] text-[#0A0A0A] shadow-[0_0_20px_rgba(255,216,0,0.4)]\" data-kid=\"4\">\n          \n          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"5\"><path d=\"M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z\" data-kid=\"6\"></path><circle cx=\"12\" cy=\"12\" r=\"3\" data-kid=\"7\"></circle></svg>\n        </div>\n        <span class=\"font-['Plus_Jakarta_Sans'] text-[14px] font-extrabold tracking-[0.12em] text-white\" data-kid=\"8\">THE CLUTCH CO</span>\n      </div>\n      <div class=\"h-9 w-9 overflow-hidden rounded-full border-2 border-white/10 p-0.5 shadow-[0_0_15px_rgba(255,255,255,0.05)]\" data-kid=\"9\">\n        <img src=\"https://i.pravatar.cc/100?u=user123\" alt=\"Avatar\" class=\"h-full w-full rounded-full object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"10\">\n      </div>\n    </header>\n\n    \n    <main class=\"h-full overflow-y-auto pt-24 pb-28 px-4 scrollbar-hide\" data-kid=\"11\">\n      \n      <div class=\"mb-8 flex flex-col gap-4\" data-kid=\"12\">\n        <div class=\"flex items-center gap-4\" data-kid=\"13\">\n          <button class=\"flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-white/10 bg-[#1B1B1B] text-[#FFD800] shadow-sm transition-all hover:border-[#FFD800]/50 active:scale-95\" data-kid=\"14\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"15\"><path d=\"m15 18-6-6 6-6\" data-kid=\"16\"></path></svg>\n          </button>\n          <div data-kid=\"17\">\n            <h1 class=\"font-['Plus_Jakarta_Sans'] text-[22px] font-extrabold tracking-tight text-white leading-tight\" data-kid=\"18\">Terms & Conditions</h1>\n            <p class=\"mt-1 text-[10px] font-bold tracking-[0.2em] text-[#A1A1AA] uppercase\" data-kid=\"19\">Updated June 2026</p>\n          </div>\n        </div>\n        <div class=\"rounded-xl border border-white/5 bg-white/5 p-4\" data-kid=\"20\">\n          <p class=\"text-[13px] leading-relaxed text-[#A1A1AA]\" data-kid=\"21\">\n            Please review our terms carefully. By continuing, you agree to our High-Octane operational protocols and performance standards.\n          </p>\n        </div>\n      </div>\n\n      \n      <div class=\"space-y-4\" data-kid=\"22\">\n        \n        \n        <div class=\"group rounded-2xl border border-white/5 bg-[#1B1B1B] p-6 transition-all hover:bg-[#1B1B1B]/80 hover:border-[#FFD800]/20\" data-kid=\"23\">\n          <div class=\"mb-4 flex items-center justify-between\" data-kid=\"24\">\n            <h2 class=\"font-['Plus_Jakarta_Sans'] text-[15px] font-bold uppercase tracking-wide text-[#FFD800]\" data-kid=\"25\">01. Service Agreement</h2>\n            <div class=\"h-1.5 w-1.5 rounded-full bg-[#FFD800] shadow-[0_0_8px_#FFD800]\" data-kid=\"26\"></div>\n          </div>\n          <p class=\"text-[14px] leading-relaxed text-[#A1A1AA]\" data-kid=\"27\">\n            This platform provides high-frequency financial tools. By activating your profile, you acknowledge that all algorithmic decisions are executed based on current market liquidity parameters.\n          </p>\n        </div>\n\n        \n        <div class=\"group rounded-2xl border border-white/5 bg-[#1B1B1B] p-6 transition-all hover:bg-[#1B1B1B]/80 hover:border-[#80FF00]/20\" data-kid=\"28\">\n          <div class=\"mb-4 flex items-center justify-between\" data-kid=\"29\">\n            <h2 class=\"font-['Plus_Jakarta_Sans'] text-[15px] font-bold uppercase tracking-wide text-[#80FF00]\" data-kid=\"30\">02. Risk Management</h2>\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#80FF00\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"31\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z\" data-kid=\"32\"></path><path d=\"M12 9v4\" data-kid=\"33\"></path><path d=\"M12 17h.01\" data-kid=\"34\"></path></svg>\n          </div>\n          <p class=\"text-[14px] leading-relaxed text-[#A1A1AA]\" data-kid=\"35\">\n            Trading involves high-octane risks. Market shifts can be instantaneous. Our <span class=\"text-[#80FF00] font-semibold\" data-kid=\"36\">Lime Flash</span> system minimizes exposure but cannot eliminate inherent volatility.\n          </p>\n        </div>\n\n        \n        <div class=\"group rounded-2xl border border-white/5 bg-[#1B1B1B] p-6 transition-all hover:bg-[#1B1B1B]/80\" data-kid=\"37\">\n          <h2 class=\"mb-4 font-['Plus_Jakarta_Sans'] text-[15px] font-bold uppercase tracking-wide text-[#FFD800]\" data-kid=\"38\">03. Security Protocols</h2>\n          <p class=\"text-[14px] leading-relaxed text-[#A1A1AA]\" data-kid=\"39\">\n            Your digital cockpit is protected by military-grade encryption. Users are strictly responsible for maintaining biometric or hardware-key security at all times.\n          </p>\n        </div>\n\n        \n        <div class=\"group rounded-2xl border border-white/5 bg-[#1B1B1B] p-6 transition-all hover:bg-[#1B1B1B]/80\" data-kid=\"40\">\n          <h2 class=\"mb-4 font-['Plus_Jakarta_Sans'] text-[15px] font-bold uppercase tracking-wide text-[#FFD800]\" data-kid=\"41\">04. Transaction Fees</h2>\n          <div class=\"mt-4 space-y-3\" data-kid=\"42\">\n             <div class=\"flex items-center justify-between rounded-lg bg-black/30 p-3\" data-kid=\"43\">\n                <span class=\"text-[12px] font-medium text-[#A1A1AA]\" data-kid=\"44\">Standard Execution</span>\n                <span class=\"font-mono text-[13px] font-bold text-[#80FF00]\" data-kid=\"45\">0.025%</span>\n             </div>\n             <div class=\"flex items-center justify-between rounded-lg bg-black/30 p-3\" data-kid=\"46\">\n                <span class=\"text-[12px] font-medium text-[#A1A1AA]\" data-kid=\"47\">Priority Withdrawal</span>\n                <span class=\"font-mono text-[13px] font-bold text-white\" data-kid=\"48\">$1.50</span>\n             </div>\n          </div>\n        </div>\n\n      </div>\n\n      \n      <div class=\"mt-12 mb-6 border-t border-white/5 pt-8 text-center\" data-kid=\"49\">\n        <p class=\"text-[11px] font-bold tracking-[0.1em] text-[#A1A1AA] uppercase mb-4\" data-kid=\"50\">Support & Transparency</p>\n        <div class=\"flex justify-center gap-6\" data-kid=\"51\">\n          <a href=\"#\" class=\"text-[10px] font-bold text-[#FFD800] uppercase tracking-widest hover:text-white transition-colors\" data-kid=\"52\">Privacy</a>\n          <a href=\"#\" class=\"text-[10px] font-bold text-[#FFD800] uppercase tracking-widest hover:text-white transition-colors\" data-kid=\"53\">Compliance</a>\n          <a href=\"#\" class=\"text-[10px] font-bold text-[#FFD800] uppercase tracking-widest hover:text-white transition-colors\" data-kid=\"54\">Safety</a>\n        </div>\n      </div>\n    </main>\n\n    \n    <nav class=\"absolute bottom-0 left-0 right-0 z-50 flex h-20 items-center justify-around border-t border-white/10 bg-[#0A0A0A]/95 px-6 backdrop-blur-xl rounded-b-[40px]\" data-kid=\"55\">\n      <button class=\"flex flex-col items-center gap-1.5 text-[#A1A1AA] transition-all hover:text-white\" data-kid=\"56\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"57\"><path d=\"m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\" data-kid=\"58\"></path><polyline points=\"9 22 9 12 15 12 15 22\" data-kid=\"59\"></polyline></svg>\n        <span class=\"text-[9px] font-black uppercase tracking-[0.15em]\" data-kid=\"60\">Home</span>\n      </button>\n      <button class=\"relative flex flex-col items-center gap-1.5 text-[#FFD800] transition-all duration-300\" data-kid=\"61\">\n        <div class=\"relative z-10\" data-kid=\"62\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"63\"><path d=\"m13 2-2 2.5h3L12 13h3L11 22\" data-kid=\"64\"></path></svg>\n          <div class=\"absolute -inset-4 -z-10 rounded-full bg-[#FFD800]/15 blur-xl animate-pulse\" data-kid=\"65\"></div>\n          <div class=\"absolute -top-1 -right-1.5 h-2.5 w-2.5 rounded-full border-2 border-[#0A0A0A] bg-[#80FF00] shadow-[0_0_10px_#80FF00]\" data-kid=\"66\"></div>\n        </div>\n        <span class=\"text-[9px] font-black uppercase tracking-[0.15em] drop-shadow-[0_0_8px_rgba(255,216,0,0.5)]\" data-kid=\"67\">Task</span>\n        <div class=\"absolute -bottom-1.5 h-[3px] w-6 rounded-full bg-[#FFD800] shadow-[0_0_15px_#FFD800]\" data-kid=\"68\"></div>\n      </button>\n      <button class=\"flex flex-col items-center gap-1.5 text-[#A1A1AA] transition-all hover:text-white\" data-kid=\"69\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"70\"><path d=\"M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z\" data-kid=\"71\"></path><polyline points=\"14 2 14 8 20 8\" data-kid=\"72\"></polyline><line x1=\"16\" y1=\"13\" x2=\"8\" y2=\"13\" data-kid=\"73\"></line><line x1=\"16\" y1=\"17\" x2=\"8\" y2=\"17\" data-kid=\"74\"></line><line x1=\"10\" y1=\"9\" x2=\"8\" y2=\"9\" data-kid=\"75\"></line></svg>\n        <span class=\"text-[9px] font-black uppercase tracking-[0.15em]\" data-kid=\"76\">Records</span>\n      </button>\n    </nav>\n\n  </div>\n</div>\n\n<style data-kid=\"77\">\n  @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n\n  /* Custom Scrollbar Hiding */\n  .scrollbar-hide::-webkit-scrollbar {\n    display: none;\n  }\n  .scrollbar-hide {\n    -ms-overflow-style: none;\n    scrollbar-width: none;\n  }\n</style>\n\n",
