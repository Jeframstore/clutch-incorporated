data-kid=\"72\">1.50 <span class=\"text-[10px] text-zinc-500\" data-kid=\"73\">USDT</span></span>\n            </div>\n            <div class=\"flex flex-col items-end\" data-kid=\"74\">\n                <span class=\"text-[9px] text-[#80FF00] uppercase font-bold tracking-[0.1em] mb-1 opacity-80\" data-kid=\"75\">Estimated Arrival</span>\n                <span class=\"text-sm font-bold text-[#80FF00] glow-lime\" data-kid=\"76\">-- USDT</span>\n            </div>\n        </div>\n      </div>\n\n      <button class=\"w-full bg-[#FFD800] text-black font-extrabold py-5 rounded-[20px] glow-gold-strong hover:scale-[1.02] active:scale-[0.98] transition-all uppercase tracking-[0.2em] text-[15px] mt-6 cursor-pointer\" data-kid=\"77\">\n        Initiate Withdrawal\n      </button>\n\n      <div class=\"flex items-center justify-center gap-6 pt-2 pb-4\" data-kid=\"78\">\n        <a href=\"#\" class=\"text-[11px] font-bold text-zinc-500 hover:text-white transition-colors uppercase tracking-wider\" data-kid=\"79\">Help Center</a>\n        <div class=\"w-1 h-1 bg-white/10 rounded-full\" data-kid=\"80\"></div>\n        <a href=\"#\" class=\"text-[11px] font-bold text-[#FFD800] hover:text-[#FFD800]/80 transition-colors uppercase tracking-wider flex items-center gap-1\" data-kid=\"81\">\n            History\n            <svg class=\"w-3 h-3\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" data-kid=\"82\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17 8l4 4m0 0l-4 4m4-4H3\" data-kid=\"83\"></path></svg>\n        </a>\n      </div>\n    </div>\n\n  </main>\n\n  \n  <nav class=\"relative z-50 h-24 px-6 glass border-t border-white/5 flex items-center justify-around\" data-kid=\"84\">\n    \n    <button class=\"flex flex-col items-center gap-1.5 group cursor-pointer\" data-kid=\"85\">\n      <div class=\"relative w-6 h-6 flex items-center justify-center\" data-kid=\"86\">\n        <svg class=\"w-6 h-6 text-zinc-500 group-hover:text-white