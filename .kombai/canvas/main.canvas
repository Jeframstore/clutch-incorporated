d=\"M7 20.662V19c0-1.657 2.239-3 5-3s5 1.343 5 3v1.662\" data-kid=\"27\"></path>\n      </svg>\n      \n      <span class=\"absolute top-0.5 right-0.5 w-[10px] h-[10px] bg-emerald-500 border-2 border-white rounded-full shadow-sm\" data-kid=\"28\"></span>\n    </button>\n  </div>\n</header>\n",
