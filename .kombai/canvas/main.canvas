ht shadow-[0_0_15px_rgba(128,255,0,0.1)] relative overflow-hidden group/score\" data-kid=\"21\">\n            <div class=\"absolute inset-0 bg-[#80FF00]/5 animate-pulse\" data-kid=\"22\"></div>\n            <span class=\"relative z-10 block text-[9px] text-[#A1A1AA] uppercase font-bold tracking-tighter mb-0.5\" data-kid=\"23\">Credit Score</span>\n            <span class=\"relative z-10 text-xl font-bold text-[#80FF00] drop-shadow-[0_0_8px_rgba(128,255,0,0.4)] tabular-nums\" data-kid=\"24\">97%</span>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"mt-8 pt-5 border-t border-white/5 flex items-center justify-between\" data-kid=\"25\">\n        <div data-kid=\"26\">\n          <span class=\"block text-[10px] text-[#A1A1AA] uppercase font-bold tracking-wider mb-1\" data-kid=\"27\">Invitation Code</span>\n          <span class=\"font-mono text-sm font-semibold tracking-widest text-white/90\" data-kid=\"28\">A4832E73</span>\n        </div>\n        <button class=\"w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center text-[#FFD800] active:scale-95 transition-transform\" data-kid=\"29\">\n          <i class=\"fa-regular fa-copy text-sm\" data-kid=\"30\"></i>\n        </button>\n      </div>\n    </section>\n\n    \n    <section class=\"grid grid-cols-2 gap-4\" data-kid=\"31\">\n      <div class=\"bg-[#1B1B1B] border border-white/5 p-4 rounded-2xl relative overflow-hidden group\" data-kid=\"32\">\n        <div class=\"absolute top-0 right-0 w-12 h-12 bg-white/5 rounded-bl-full -mr-4 -mt-4 opacity-20\" data-kid=\"33\"></div>\n        <span class=\"block text-[10px] text-[#A1A1AA] uppercase font-bold tracking-wider mb-2\" data-kid=\"34\">Account Balance</span>\n        <div class=\"flex items-baseline gap-1\" data-kid=\"35\">\n          <span class=\"text-xl font-bold text-white tabular-nums\" data-kid=\"36\">0.00</span>\n          <span class=\"text-[10px] font-bold text-[#A1A1AA]\" data-kid=\"37\">USDT</span>\n        </div>\n        <div cla